function agregarEmoji() {

  const textarea =
    document.getElementById("nuevo-texto");

  textarea.value += " 😊";

  textarea.focus();

}


/* ==========================================
   UTILIDADES
   ========================================== */

function escaparHTML(texto) {

  const div =
    document.createElement("div");

  div.textContent = texto;

  return div.innerHTML;

}


/* ==========================================
   INICIO
   ========================================== */

document.addEventListener(
  "DOMContentLoaded",
  () => {

    actualizarGuardados();

    const publicaciones =
      localStorage.getItem(
        "vyro_publicaciones"
      );

    if (publicaciones) {

      document.getElementById(
        "publicaciones"
      ).textContent = publicaciones;

    }

  }
);
