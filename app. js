    "📸 Las historias estarán disponibles próximamente."
  );

}


/* ==========================================
   NOTIFICACIONES
   ========================================== */

function mostrarNotificaciones() {

  irA("notificaciones");

  const contador =
    document.getElementById(
      "contador-notificaciones"
    );

  contador.style.display = "none";

}


/* ==========================================
   MENSAJES
   ========================================== */

function mostrarMensajes() {

  irA("mensajes");

}

function enviarMensaje() {

  const input =
    document.getElementById("mensaje-input");

  const texto =
    input.value.trim();

  if (!texto) return;

  const mensajes =
    document.querySelector(".mensajes");

  const nuevo =
    document.createElement("div");

  nuevo.className =
    "mensaje enviado";

  nuevo.textContent = texto;

  mensajes.appendChild(nuevo);

  input.value = "";

  mensajes.scrollTop =
    mensajes.scrollHeight;

}

function teclaMensaje(event) {

  if (event.key === "Enter") {

    enviarMensaje();

  }

}


/* ==========================================
   PERFIL
   ========================================== */

function editarPerfil() {

  const nombre =
    prompt(
      "¿Cuál quieres que sea tu nombre?",
      "Snyder"
    );

  if (!nombre) return;

  const nombreLimpio =
    nombre.trim();

  if (!nombreLimpio) return;

  document.getElementById(
    "perfil-nombre"
  ).textContent = nombreLimpio;

  document.getElementById(
    "nombre-mini"
  ).textContent = nombreLimpio;

  mostrarToast("✓ Perfil actualizado");

}


/* ==========================================
   CONFIGURACIÓN
   ========================================== */

function mostrarConfiguracion() {

  const opcion =
    confirm(
      "VYRO\n\n¿Quieres activar el modo oscuro?"
    );

  if (opcion) {

    document.body.classList.toggle("modo-extra");

    mostrarToast("⚙️ Configuración actualizada");

  }

}


